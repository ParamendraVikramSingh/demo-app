# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/chatcommerce

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m

# Redis
REDIS_URL=redis://localhost:6379

# Logging
LOG_TO_FILE=true
# Threshold in ms above which a "slow_endpoint_detected" warning is emitted
SLOW_THRESHOLD_MS=1000

# Payment simulation
# Delay in ms for the simulated external payment call
PAYMENT_TIMEOUT_MS=500
# Set to true to randomly fail ~30% of payment calls (for RCA demos)
PAYMENT_RANDOM_FAIL=false

# Message failure simulation (set true to force DB write fail on /messages/send)
SIMULATE_MSG_FAIL=false
